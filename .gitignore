# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv/

# Local-only docs, not part of the public repo
CLAUDE.md
guide.md

# Environment & secrets
.env
.env.local

# Stage 2 response cache -- COMMITTED, deliberately.
#
# Cache keys are (txn_id, candidate set, model, prompt version), and the
# generator is seeded, so the same seed reproduces the same keys on any machine.
# Committing it means the deployed demo and a fresh clone both show real LLM
# exception notes with no API key, no latency and no spend -- a stronger
# reproducibility claim than a seed alone, and the difference between a demo
# that works on conference wifi and one that does not.
.cache/*
!.cache/llm/

# SQLite audit database
*.db
*.sqlite

# NOTE: data/ is deliberately committed, not ignored. A committed eval report
# is only interpretable against the exact batch that produced it, and the
# generator changes as rules evolve. Each manifest.json records its seed, so
# any batch can be rebuilt byte-identically.

# Pytest & type checking caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Streamlit. The theme is part of the deliverable and is committed; only the
# secrets file is kept out.
.streamlit/secrets.toml
streamlit_cached_theme.json

# IDE/OS files
.DS_Store
*.swp
*.swo
*~

# Logs
*.log
logs/

# The audit trail is generated per run, not committed. `make demo` rebuilds it.
audit.db
