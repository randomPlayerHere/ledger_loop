# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Which provider is used is decided by `llm.provider` in config.yaml, not here.
# Only the key for the active provider needs to be set.

# Default provider. Free tier at https://console.groq.com/keys
# Note: the free tier caps at 200k tokens/day, which one pass over a 520-line
# batch very nearly exhausts. Fine for a demo, tight for iteration.
GROQ_API_KEY=gsk_...

# llm.provider: nim -- free key at https://build.nvidia.com (no card).
# Metered in request credits rather than tokens, so a full eval is ~110 of
# ~1,000 credits and finishes in minutes instead of half an hour.
NVIDIA_API_KEY=nvapi-...

# Only needed when config.yaml sets llm.provider: anthropic
# (also needs `uv sync --extra anthropic`)
ANTHROPIC_API_KEY=sk-ant-...
