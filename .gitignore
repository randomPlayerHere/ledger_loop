# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv/

# Local-only docs, not part of the public repo
CLAUDE.md
guide.md

# Environment & secrets
.env
.env.local

# Stage 2 response cache. Ignored by default because it churns while the prompt
# is being tuned. Worth un-ignoring before the deadline: a committed cache makes
# `make eval BATCH=dev` reproduce the reported LLM numbers with no API key at
# all, which is a stronger reproducibility claim than a seed alone.
.cache/

# SQLite audit database
*.db
*.sqlite

# NOTE: data/ is deliberately committed, not ignored. A committed eval report
# is only interpretable against the exact batch that produced it, and the
# generator changes as rules evolve. Each manifest.json records its seed, so
# any batch can be rebuilt byte-identically.

# Pytest & type checking caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Streamlit
.streamlit/
streamlit_cached_theme.json

# IDE/OS files
.DS_Store
*.swp
*.swo
*~

# Logs
*.log
logs/

# The audit trail is generated per run, not committed. `make demo` rebuilds it.
audit.db
